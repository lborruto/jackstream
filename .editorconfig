root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt indents Go with tabs.
[{*.go,go.mod}]
indent_style = tab

[*.{sh,html}]
indent_size = 2

# The keypair is written by scripts/refresh-certs.sh as the service serves it.
[*.pem]
insert_final_newline = unset
trim_trailing_whitespace = unset

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
